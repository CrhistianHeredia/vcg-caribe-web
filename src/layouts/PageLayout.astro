---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { pageMeta } from '../config/seo';

interface Props {
  page?: keyof typeof pageMeta;
  title?: string;
  description?: string;
  image?: string;
}

const { page, title, description, image } = Astro.props;
---

<Layout page={page} title={title} description={description} image={image}>
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</Layout>
